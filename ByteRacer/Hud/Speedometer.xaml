<UserControl x:Class="ByteRacer.Hud.Speedometer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ByteRacer.Hud"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             IsHitTestVisible="False">
    <Border Background="#CC000000" BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="4" Padding="10,8">

        <StackPanel>
            <!-- Snelheid + eenheid -->
            <Grid>
                <TextBlock x:Name="SpeedText" Text="000" FontSize="28" Foreground="White"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="KM/H" FontSize="10" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,0,2"/>
            </Grid>

            <StackPanel x:Name="SegmentPanel" Orientation="Horizontal"
                        Height="20" Margin="0,8,0,0"/>

            <TextBlock x:Name="EffectText" Text=" " FontSize="9"
                       Margin="0,8,0,0" Visibility="Hidden"/>
        </StackPanel>

    </Border>
</UserControl>
