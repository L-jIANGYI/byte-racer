<UserControl x:Class="ByteRacer.Views.NameEntryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ByteRacer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" d:FontFamily  ="{StaticResource PixelFont}">
    <Grid Background="#1E1E1E">

        <!-- Background image: uncomment when the file exists -->
        <!--
    <Image Source="pack://application:,,,/Assets/Images/background.png"
           Stretch="UniformToFill"
           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    -->

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Height="244">
            <TextBlock Text="Enter Name"
                       Foreground="White"
                       FontSize="48"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>
            <Button Content="Play" FontWeight="Bold" Width="80" Height="40"/>

        </StackPanel>

        <Button Content="Exit" FontWeight="Bold" Width="60" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="ExitButton_Click"/>
    </Grid>
</UserControl>
