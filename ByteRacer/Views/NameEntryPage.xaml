<UserControl x:Class="ByteRacer.Views.NameEntryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ByteRacer.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             FontFamily="{StaticResource PixelFont}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>
        
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Image Source="pack://application:,,,/Assets/Images/background.png"
       Stretch="UniformToFill"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Enter Name"
                       Foreground="White"
                       FontSize="32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBox x:Name="NameTextBox"
                     Width="350" Height="60"
                     FontSize="24"
                     MaxLength="14"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,30"/>

            <Button Content="Play" FontSize="14" Width="120" Height="40"  Click="PlayButton_Click" Style="{StaticResource PixelButton}"/>
        </StackPanel>

        <Button Content="Back" FontSize="12" Width="83" Height="33"
           
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                Click="ExitButton_Click" Style="{StaticResource PixelButton}"/>
    </Grid>
</UserControl>