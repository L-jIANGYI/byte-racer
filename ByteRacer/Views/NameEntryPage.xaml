<UserControl x:Class="ByteRacer.Views.NameEntryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             FontFamily="{StaticResource PixelFont}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFCC00"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderOptions.EdgeMode="Aliased">
                            <Grid Margin="4,4,0,0">
                                <Border Background="#7A5C00" Margin="4,0"/>
                                <Border Background="#7A5C00" Margin="0,4"/>
                            </Grid>
                            <Grid x:Name="face" Margin="0,0,4,4">
                                <Border Background="{TemplateBinding Background}" Margin="4,0"/>
                                <Border Background="{TemplateBinding Background}" Margin="0,4"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE066"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Margin" Value="4,4,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Image Source="pack://application:,,,/Assets/Images/background.png"
       Stretch="UniformToFill"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Enter Name"
                       Foreground="White"
                       FontSize="32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBox x:Name="NameTextBox"
                     Width="350" Height="60"
                     FontSize="24"
                     MaxLength="14"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,30"/>

            <Button Content="Play" FontSize="14" Width="120" Height="40"  Click="PlayButton_Click"/>
        </StackPanel>

        <Button Content="Back" FontSize="12" Width="83" Height="33"
           
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                Click="ExitButton_Click"/>
    </Grid>
</UserControl>