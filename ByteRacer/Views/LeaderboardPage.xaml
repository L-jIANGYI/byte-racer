<UserControl x:Class="ByteRacer.Views.LeaderboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ByteRacer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>

        <Button
    Content="&lt;"
    FontSize="24"
    Width="50"
    Height="50" Margin="0,0,100,30"/>

        <!-- Titel -->
        <TextBlock
        Text="Leaderboard"
      
        FontSize="32"
        Grid.Row="0"
        Grid.Column="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <!-- Headers -->
        <TextBlock
        Text="Rank"
        FontSize="20"
        Grid.Row="1"
        Grid.Column="0"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <TextBlock
        Text="Gebruikersnaam"
        FontSize="20"
        Grid.Row="1"
        Grid.Column="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <TextBlock
        Text="Tijd"
        FontSize="20"
        Grid.Row="1"
        Grid.Column="2"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <!-- Lijn -->
        <Rectangle
        Grid.Row="2"
        Grid.Column="0"
        Grid.ColumnSpan="3"
        Height="2"
        Fill="Black"/>

        <!-- Rank 1 -->
        <TextBlock
        Text="1"
        FontSize="18"
        Grid.Row="3"
        Grid.Column="0"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <TextBlock
        Text="Gebruikersnaam 1"
        FontSize="18"
        Grid.Row="3"
        Grid.Column="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <TextBlock
        Text="00:42"
        FontSize="18"
        Grid.Row="3"
        Grid.Column="2"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <!-- Rank 2 -->
        <TextBlock
        Text="2"
        FontSize="18"
        Grid.Row="4"
        Grid.Column="0"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <TextBlock
        Text="Gebruikersnaam 2"
        FontSize="18"
        Grid.Row="4"
        Grid.Column="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <TextBlock
        Text="00:57"
        FontSize="18"
        Grid.Row="4"
        Grid.Column="2"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <!-- Rank 3 -->
        <TextBlock
        Text="3"
        FontSize="18"
        Grid.Row="5"
        Grid.Column="0"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <TextBlock
        Text="Gebruikersnaam 3"
        FontSize="18"
        Grid.Row="5"
        Grid.Column="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <TextBlock
        Text="01:13"
        FontSize="18"
        Grid.Row="5"
        Grid.Column="2"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

    </Grid>
</UserControl>