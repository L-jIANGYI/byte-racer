<UserControl x:Class="ByteRacer.Views.LeaderboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Focusable="True"
             KeyDown="OnKeyDown">

    <UserControl.Resources>

        <!-- Podiumkleuren -->
        <SolidColorBrush x:Key="GoldBrush" Color="#FFCC00"/>
        <SolidColorBrush x:Key="GoldShadowBrush" Color="#7A5C00"/>
        <SolidColorBrush x:Key="SilverBrush" Color="#C9D1D9"/>
        <SolidColorBrush x:Key="SilverShadowBrush" Color="#5E6670"/>
        <SolidColorBrush x:Key="BronzeBrush" Color="#D9893B"/>
        <SolidColorBrush x:Key="BronzeShadowBrush" Color="#7A4416"/>

        <!-- Podiumblok: pixelstijl -->
        <Style x:Key="PodiumBlock" TargetType="ContentControl">
            <Setter Property="Width" Value="104"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True">
                            <Grid Margin="4,4,0,0">
                                <Border Background="{TemplateBinding BorderBrush}" Margin="4,0"/>
                                <Border Background="{TemplateBinding BorderBrush}" Margin="0,4"/>
                            </Grid>
                            <Grid Margin="0,0,4,4">
                                <Border Background="{TemplateBinding Background}" Margin="4,0"/>
                                <Border Background="{TemplateBinding Background}" Margin="0,4"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template voor naam + tijd boven podium -->
        <DataTemplate x:Key="PodiumEntryTemplate">
            <StackPanel Margin="0,0,0,10">
                <Border x:Name="NameBg" HorizontalAlignment="Center" Padding="4,3" Background="Transparent">
                    <TextBlock x:Name="NameText" Text="{Binding Name}"
                           FontSize="8" Foreground="White"
                           MaxWidth="112" TextTrimming="CharacterEllipsis"
                           Effect="{StaticResource TextShadow}"/>
                </Border>
                <TextBlock x:Name="TimeText" Text="{Binding Time}"
                       FontSize="10" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,6,0,0"
                       Effect="{StaticResource TextShadow}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                    <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLatest}" Value="True">
                    <Setter TargetName="NameBg" Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="#1E1E1E"/>
                    <Setter TargetName="NameText" Property="Effect" Value="{x:Null}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--Template voor 4 t/m 10 -->
        <DataTemplate x:Key="RowTemplate">
            <Border x:Name="RowBg" Height="26" Padding="10,0" Background="Transparent">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="RankText" Grid.Column="0"
                           Text="{Binding Rank, StringFormat={}{0}.}"
                           FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="NameText" Grid.Column="1"
                           Text="{Binding Name}"
                           FontSize="10" Foreground="White"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TimeText" Grid.Column="2"
                           Text="{Binding Time}"
                           FontSize="10" Foreground="White"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter TargetName="RankText" Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                    <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLatest}" Value="True">
                    <Setter TargetName="RowBg" Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="RankText" Property="Foreground" Value="#1E1E1E"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="#1E1E1E"/>
                    <Setter TargetName="TimeText" Property="Foreground" Value="#1E1E1E"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">

        <Image Source="pack://application:,,,/Assets/Images/background.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" Opacity="0.4"/>

        <Button Content="Back" FontSize="12" Width="83" Height="33"
            Style="{StaticResource PixelButton}" Focusable="False"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
            Click="BackButton_Click"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="LEADERBOARD"
                   FontSize="32" Foreground="White" 
                   HorizontalAlignment="Center" Margin="0,0,0,28"
                   Effect="{StaticResource TitleShadow}"/>

            <StackPanel Orientation="Horizontal">

                <!-- ===== Podium: 2 - 1 - 3 ===== -->
                <StackPanel VerticalAlignment="Bottom">
                    <Grid Width="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- 2e plek -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <ContentControl x:Name="SecondPlace" Focusable="False"
                                        ContentTemplate="{StaticResource PodiumEntryTemplate}"/>
                            <ContentControl Style="{StaticResource PodiumBlock}" Content="2" Height="82"
                                        Background="{StaticResource SilverBrush}"
                                        BorderBrush="{StaticResource SilverShadowBrush}"/>
                        </StackPanel>

                        <!-- 1e plek -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <Viewbox Width="28" Height="16" Margin="0,0,0,6">
                                <Canvas Width="7" Height="4" RenderOptions.EdgeMode="Aliased">
                                    <Path Fill="{StaticResource GoldBrush}"
                                      Data="M0,0 H1 V2 H2 V1 H3 V0 H4 V1 H5 V2 H6 V0 H7 V4 H0 Z"/>
                                </Canvas>
                            </Viewbox>
                            <ContentControl x:Name="FirstPlace" Focusable="False"
                                        ContentTemplate="{StaticResource PodiumEntryTemplate}"/>
                            <ContentControl Style="{StaticResource PodiumBlock}" Content="1" Height="112"
                                        Background="{StaticResource GoldBrush}"
                                        BorderBrush="{StaticResource GoldShadowBrush}"/>
                        </StackPanel>

                        <!-- 3e plek -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <ContentControl x:Name="ThirdPlace" Focusable="False"
                                        ContentTemplate="{StaticResource PodiumEntryTemplate}"/>
                            <ContentControl Style="{StaticResource PodiumBlock}" Content="3" Height="60"
                                        Background="{StaticResource BronzeBrush}"
                                        BorderBrush="{StaticResource BronzeShadowBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="4" Background="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Plek 4 t/m 10 -->
                <Border Background="Black"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="4"
                        Width="340" Padding="8,10" Margin="28,0,0,0"
                        VerticalAlignment="Bottom">
                    <StackPanel>
                        <ItemsControl x:Name="RestList" Focusable="False"
                                      ItemTemplate="{StaticResource RowTemplate}"/>

                        <!-- Eigen plek buiten de top 10 -->
                        <StackPanel x:Name="YourRankPanel" Visibility="Collapsed">
                            <TextBlock Text="· · ·" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,4"/>
                            <ContentControl x:Name="YourRankRow" Focusable="False"
                                            ContentTemplate="{StaticResource RowTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>