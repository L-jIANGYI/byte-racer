<UserControl x:Class="ByteRacer.Views.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ByteRacer.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" d:FontFamily  ="{StaticResource PixelFont}">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>
    <Grid Background="#1E1E1E">

        <!-- Background image: uncomment when the file exists -->
        <!--
    <Image Source="pack://application:,,,/Assets/Images/background.png"
           Stretch="UniformToFill"
           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    -->

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="BYTE RACER"
                       Foreground="White"
                       FontSize="48"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>


            <Button Content="Start Game" FontWeight="Bold" Width="150" Height="40" Margin="0,5"/>
            <Button Content="Leaderboard" FontWeight="Bold" Width="150" Height="40" Margin="0,5"/>
            <Button Content="Settings" FontWeight="Bold" Width="150" Height="40" Margin="0,5"/>
            <Button Content="Info" FontWeight="Bold" Width="80" Height="40" Margin="0,5"/>
        </StackPanel>

        <Button Content="Exit" FontWeight="Bold" Width="60" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="ExitButton_Click"/>
    </Grid>
</UserControl>