<UserControl x:Class="ByteRacer.Views.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ByteRacer.Views"
             xmlns:overlays="clr-namespace:ByteRacer.Overlays"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" d:FontFamily  ="{StaticResource PixelFont}">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFCC00"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderOptions.EdgeMode="Aliased">
                            <Grid Margin="4,4,0,0">
                                <Border Background="#7A5C00" Margin="4,0"/>
                                <Border Background="#7A5C00" Margin="0,4"/>
                            </Grid>
                            <Grid x:Name="face" Margin="0,0,4,4">
                                <Border Background="{TemplateBinding Background}" Margin="4,0"/>
                                <Border Background="{TemplateBinding Background}" Margin="0,4"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE066"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Margin" Value="4,4,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="#1E1E1E">

        <!-- Background image: uncomment when the file exists -->
        <!--
    <Image Source="pack://application:,,,/Assets/Images/background.png"
           Stretch="UniformToFill"
           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    -->

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="BYTE RACER"
                       Foreground="White"
                       FontSize="52"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>


            <Button Content="Start Game"  Width="250" Height="40" Margin="0,5" Click="StartButton_Click"/>
            <Button Content="Leaderboard"  Width="250" Height="40" Margin="0,5" Click="LeaderboardButton_Click"/>
            <Button Content="Settings"  Width="250" Height="40" Margin="0,5"/>
            <Button Content="Info"  Width="250" Height="40" Margin="0,5" Click="InfoButton_Click"/>
        </StackPanel>

        <Button Content="Exit"  Width="100" Height="40"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="ExitButton_Click"/>

        <overlays:InfoOverlay x:Name="InfoPanel" Visibility="Collapsed"/>
    </Grid>
</UserControl>