<UserControl x:Class="ByteRacer.Views.GamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="2000" d:DesignWidth="3000 " d:Background="White"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <Grid>
        <!-- Viewport: wat op scherm ziet -->
        <Canvas x:Name="Viewport" Background="Aqua" ClipToBounds="True">

            <!-- World: Hele wereld -->
            <Canvas x:Name="World">
                <Canvas.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,100,100" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#3A7D44">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#4C8F55" Thickness="2"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,100,100"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>

                <!-- Camera -->
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="Camera"/>
                </Canvas.RenderTransform>

                <!-- Auto: in World Canvas, met World bewegen -->
                <Grid x:Name="CarVisual" Width="44" Height="22" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="CarRotation"></RotateTransform>
                    </Grid.RenderTransform>
                    <Border Background="Red" CornerRadius="5"></Border>
                    <Border Background="DarkGray" Width="7" HorizontalAlignment="Right" Margin="0,3,7,3" CornerRadius="2"></Border>
                </Grid>
            </Canvas>
        </Canvas>

        <!-- Startlights on countdown -->
        <Border x:Name="StartLights" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                Background="#E6111111" CornerRadius="12" Padding="14,10">
            <StackPanel x:Name="StartLightsPanel" Orientation="Horizontal">
                <Ellipse Width="44" Height="44" Margin="6"/>
                <Ellipse Width="44" Height="44" Margin="6"/>
                <Ellipse Width="44" Height="44" Margin="6"/>
                <Ellipse Width="44" Height="44" Margin="6"/>
                <Ellipse Width="44" Height="44" Margin="6"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="RaceTimeText" Text="00:00.00" FontSize="28" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>

        <TextBlock x:Name="CenterText" Visibility="Collapsed" IsHitTestVisible="False"
                   FontSize="96" Foreground="White" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- DebugText: buiten World, fixed Top, Left op scherm -->
        <TextBlock x:Name="DebugText" Foreground="White" FontFamily="Consolas" FontSize="16" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
    
</UserControl>
