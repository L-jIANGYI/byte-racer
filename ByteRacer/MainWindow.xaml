<Window x:Class="ByteRacer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ByteRacer"
        mc:Ignorable="d"
        Title="Byte Racer" Width="816" Height="489"
        MinWidth="640" MinHeight="400"
        Background="#1E1E1E"
        FontFamily="{StaticResource PixelFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased">
    <Grid SizeChanged="Root_SizeChanged">
        <ContentControl x:Name="PageHost"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
            <ContentControl.LayoutTransform>
                <ScaleTransform x:Name="PageScale"/>
            </ContentControl.LayoutTransform>
        </ContentControl>
    </Grid>
</Window>