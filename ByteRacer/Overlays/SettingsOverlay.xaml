<UserControl x:Class="ByteRacer.Overlays.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ByteRacer.Overlays"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#CC000000">

        <Button Content="Back" FontSize="12" Width="90" Height="40"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                Click="BackButton_Click"/>

        <TextBlock Text="SETTINGS"
                   Foreground="White"
                   FontSize="32"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,50,0,0"/>

        <Border Background="Black"
                BorderBrush="#FFCC00"
                BorderThickness="4"
                Width="500" Height="180"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="30">

            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="0" Width="56" Height="48">
                    <Canvas Width="14" Height="12" RenderOptions.EdgeMode="Aliased">
                        <Path Fill="#FFCC00"
                              Data="M0,4 H3 V3 H4 V2 H5 V1 H6 V0 H7 V12 H6 V11 H5 V10 H4 V9 H3 V8 H0 Z"/>
                        <Path x:Name="Wave1" Fill="#FFCC00" Data="M9,4 H10 V8 H9 Z"/>
                        <Path x:Name="Wave2" Fill="#FFCC00" Data="M11,2 H12 V10 H11 Z"/>
                        <Path x:Name="Wave3" Fill="#FFCC00" Data="M13,0 H14 V12 H13 Z"/>
                    </Canvas>
                </Viewbox>

                <Slider x:Name="VolumeSlider"
                        Grid.Column="1"
                        Minimum="0" Maximum="100" Value="50"
                        ValueChanged="VolumeSlider_ValueChanged"
                        VerticalAlignment="Center"
                        Margin="25,0,0,0"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>