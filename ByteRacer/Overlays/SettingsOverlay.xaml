<UserControl x:Class="ByteRacer.Overlays.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ByteRacer.Overlays"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#CC000000">

        <Button Content="Back" FontSize="12" Width="90" Height="40"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                Click="BackButton_Click" Style="{StaticResource PixelButton}"/>

        <TextBlock Text="SETTINGS"
                   Foreground="White"
                   FontSize="32"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,50,0,0"/>

        <Border Background="Black"
        BorderBrush="#FFCC00"
        BorderThickness="4"
        Width="500"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        Padding="30">

            <StackPanel>

                <!-- volume row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Width="56" Height="48">
                        <Canvas Width="14" Height="12" RenderOptions.EdgeMode="Aliased">
                            <Path Fill="#FFCC00"
                                  Data="F1 M5,0 H6 V9 H5 Z M6,0 H8 V1 H6 Z M7,1 H8 V4 H7 Z M2,8 H5 V9 H2 Z M1,9 H6 V11 H1 Z M2,11 H5 V12 H2 Z"/>
                            <Path x:Name="Wave1" Fill="#FFCC00" Data="M9,4 H10 V8 H9 Z"/>
                            <Path x:Name="Wave2" Fill="#FFCC00" Data="M11,2 H12 V10 H11 Z"/>
                            <Path x:Name="Wave3" Fill="#FFCC00" Data="M13,0 H14 V12 H13 Z"/>
                        </Canvas>
                    </Viewbox>

                    <Slider x:Name="VolumeSlider"
                    Grid.Column="1"
                    Minimum="0" Maximum="100"
                    IsMoveToPointEnabled="True"
                    ValueChanged="VolumeSlider_ValueChanged"
                    VerticalAlignment="Center"
                    Margin="25,0,0,0"/>
                </Grid>

                <!-- sounds effect row -->
                <!--<Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Width="56" Height="48">
                        <Canvas Width="14" Height="12" RenderOptions.EdgeMode="Aliased">
                            <Path Fill="#FFCC00"
                                   Data="M0,4 H3 V3 H4 V2 H5 V1 H6 V0 H7 V12 H6 V11 H5 V10 H4 V9 H3 V8 H0 Z"/>
                            <Path x:Name="SfxWave1" Fill="#FFCC00" Data="M9,4 H10 V8 H9 Z"/>
                            <Path x:Name="SfxWave2" Fill="#FFCC00" Data="M11,2 H12 V10 H11 Z"/>
                            <Path x:Name="SfxWave3" Fill="#FFCC00" Data="M13,0 H14 V12 H13 Z"/>
                        </Canvas>
                    </Viewbox>

                    <Slider x:Name="SfxSlider"
                            Grid.Column="1"
                            Minimum="0" Maximum="100"
                            ValueChanged="SfxSlider_ValueChanged"
                            PreviewMouseLeftButtonUp="SfxSlider_Released"
                            VerticalAlignment="Center"
                            Margin="25,0,0,0"/>
                </Grid>-->


                <UniformGrid Columns="3" Margin="0,35,0,0">
                    <Button Content="Fullscreen" FontSize="10" Height="40"
                    Click="FullscreenButton_Click" Width="115" Style="{StaticResource PixelButton}"/>
                    <Button Content="Borderless" FontSize="10" Height="40"
                    Click="BorderlessButton_Click" Width="115" Style="{StaticResource PixelButton}"/>
                    <Button Content="Bordered" FontSize="10" Height="40"
                    Click="BorderedButton_Click" Width="115" Style="{StaticResource PixelButton}"/>
                </UniformGrid>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>