<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\Fonts\PressStart2P-Regular.ttf" />
		<None Remove="Assets\Images\background.png" />
		<None Remove="Assets\Images\carsprite.png" />
		<None Remove="Assets\Images\Icons\quizblock.png" />
		<None Remove="Assets\Sounds\menu-music.mp3" />
		<None Remove="Assets\Images\Icons\python.png" />
		<None Remove="Assets\Images\Icons\spdbst.png" />
		<None Remove="Data\questions.json" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\Sounds\menu-music.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Data\questions.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\Fonts\PressStart2P-Regular.ttf">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Assets\Images\carsprite.png" />
		<Resource Include="Assets\Images\Icons\python.png" />
		<Resource Include="Assets\Images\Icons\quizblock.png" />
		<Resource Include="Assets\Images\Icons\spdbst.png" />
		<Resource Include="Assets\Images\background.png" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Assets\Fonts\OFL.txt">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>